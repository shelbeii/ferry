{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferry",
  "version": "0.13.23",
  "identifier": "com.captain.ferry",
  "build": {
    "beforeDevCommand": "npm run dev:prepare",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/ferry"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" },
    "windows": {
      "nsis": { "languages": ["SimpChinese"], "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" }
    }
  }
}
